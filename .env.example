# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Public canonical URL (no trailing slash). Used for canonical/hreflang/OG/sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://hasviktech.com

# Resend (https://resend.com) API key for the quote form. Without it:
#   - development: submissions are logged to the server console and succeed
#   - production:  the form shows an error (so a missing key is noticed)
RESEND_API_KEY=

# Where quote requests are delivered.
CONTACT_TO_EMAIL=sales@hasviktech.com

# Sender address. Must be on a domain verified in Resend (e.g. "HASVIK Website <website@hasviktech.com>").
# Until the domain is verified, Resend's test sender works: "HASVIK Website <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=HASVIK Website <onboarding@resend.dev>
